{
  "name": "veyro-app",
  "productName": "Veyro",
  "version": "1.0.0",
  "description": "Veyro \u2014 restyle the card art in Apple Wallet from your Mac.",
  "author": "Veyro",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "bash scripts/fetch-python.sh && bash scripts/stage-backend.sh && electron-builder --mac dir --arm64 && bash scripts/make-dmg.sh",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "biz.veyro.app",
    "productName": "Veyro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Veyro",
      "background": "build/background.png",
      "iconSize": 112,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 235,
          "type": "file"
        },
        {
          "x": 400,
          "y": 235,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ]
  }
}
